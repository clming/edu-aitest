# 数据库配置
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edu_assistant?sslmode=disable

# Redis 配置
REDIS_URL=redis://localhost:6379

# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=edu-assistant-secret-key-2026-change-me

# 服务端口
PORT=8080

# 环境：development, staging, production
ENV=development

# 日志级别：debug, info, warn, error
LOG_LEVEL=info
